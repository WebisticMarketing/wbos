generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  role          String         @default("admin")
  loginAttempts Int            @default(0)
  lockedUntil   DateTime?
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      AdminSession[]
  auditLogs     AuditLog[]
  notifications Notification[]
  wbosAuditLogs WbosAuditLog[]

  @@index([email])
  @@map("admins")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([token])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Lead {
  id           String        @id @default(cuid())
  name         String?
  business     String?
  email        String?
  whatsapp     String?
  service      String?
  goal         String?
  status       String        @default("new")
  source       String        @default("chatbot")
  notes        String?
  ipAddress    String?
  userAgent    String?
  referrer     String?
  score        Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  client       Client?
  conversation Conversation?

  @@index([email])
  @@index([whatsapp])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@map("leads")
}

model Conversation {
  id        String    @id @default(cuid())
  sessionId String    @unique
  status    String    @default("active")
  leadId    String?   @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lead      Lead?     @relation(fields: [leadId], references: [id])
  messages  Message[]

  @@index([sessionId])
  @@index([status])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@map("messages")
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limits")
}

model Client {
  id           String            @id @default(cuid())
  leadId       String?           @unique
  name         String
  email        String?
  whatsapp     String?
  business     String?
  service      String
  status       String            @default("active")
  startDate    DateTime          @default(now())
  endDate      DateTime?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  onboarding   ClientOnboarding?
  lead         Lead?             @relation(fields: [leadId], references: [id])
  payments     Payment[]
  projects     Project[]
  revenues     Revenue[]
  tasks        Task[]
  wbosBusiness WbosBusiness?

  @@index([email])
  @@index([status])
  @@index([service])
  @@map("clients")
}

model Revenue {
  id          String   @id @default(cuid())
  clientId    String
  amount      Float
  description String?
  service     String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([date])
  @@index([service])
  @@map("revenues")
}

model Project {
  id                String             @id @default(cuid())
  clientId          String
  name              String
  description       String?
  service           String
  status            String             @default("active")
  startDate         DateTime           @default(now())
  endDate           DateTime?
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payments          Payment[]
  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  recurringPayments RecurringPayment[]
  tasks             Task[]

  @@index([clientId])
  @@index([status])
  @@map("projects")
}

model TeamMember {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  role          String
  avatar        String?
  phone         String?
  bio           String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignedTasks Task[]   @relation("AssignedTasks")

  @@map("team_members")
}

model Task {
  id               String      @id @default(cuid())
  title            String
  description      String?
  status           String      @default("todo")
  priority         String      @default("medium")
  projectId        String?
  clientId         String?
  assignedTo       String?
  dueDate          DateTime?
  completedAt      DateTime?
  createdBy        String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  assignedToId     String?
  assignedToMember TeamMember? @relation("AssignedTasks", fields: [assignedToId], references: [id])
  client           Client?     @relation(fields: [clientId], references: [id])
  project          Project?    @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assignedToId])
  @@map("tasks")
}

model OnboardingTemplate {
  id                String             @id @default(cuid())
  name              String
  serviceType       String
  description       String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clientOnboardings ClientOnboarding[]
  steps             OnboardingStep[]

  @@index([serviceType])
  @@map("onboarding_templates")
}

model OnboardingStep {
  id          String                 @id @default(cuid())
  templateId  String
  stepNumber  Int
  title       String
  description String?
  isRequired  Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  clientSteps ClientOnboardingStep[]
  template    OnboardingTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([stepNumber])
  @@map("onboarding_steps")
}

model ClientOnboarding {
  id          String                 @id @default(cuid())
  clientId    String                 @unique
  templateId  String
  status      String                 @default("not-started")
  startedAt   DateTime               @default(now())
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  steps       ClientOnboardingStep[]
  client      Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template    OnboardingTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([status])
  @@map("client_onboardings")
}

model ClientOnboardingStep {
  id           String           @id @default(cuid())
  onboardingId String
  stepId       String
  status       String           @default("pending")
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  onboarding   ClientOnboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  step         OnboardingStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([onboardingId, stepId])
  @@index([onboardingId])
  @@index([status])
  @@map("client_onboarding_steps")
}

model RecurringPayment {
  id              String   @id @default(cuid())
  projectId       String
  amount          Float
  frequency       String   @default("monthly")
  nextPaymentDate DateTime
  status          String   @default("active")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([nextPaymentDate])
  @@index([status])
  @@map("recurring_payments")
}

model Payment {
  id          String    @id @default(cuid())
  projectId   String
  clientId    String
  amount      Float
  paymentDate DateTime  @default(now())
  dueDate     DateTime?
  status      String    @default("paid")
  method      String?
  reference   String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@map("payments")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  admin     Admin     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model Template {
  id        String   @id @default(cuid())
  name      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("templates")
}

model WbosBusiness {
  id                  String               @id @default(cuid())
  clientId            String               @unique
  name                String
  industry            String
  logo                String?
  email               String?
  phone               String?
  address             String?
  website             String?
  currency            String               @default("PKR")
  timezone            String               @default("Asia/Karachi")
  dateFormat          String               @default("DD/MM/YYYY")
  status              String               @default("active")
  suspendedAt         DateTime?
  suspensionReason    String?
  createdBy           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  slug                String?              @unique
  addaExpenses        AddaExpense[]
  addaIncomes         AddaIncome[]
  busFuelRecords      BusFuelRecord[]
  busMaintenance      BusMaintenance[]
  busTyres            BusTyre[]
  busVouchers         BusVoucher[]
  buses               Bus[]
  modules             BusinessModule[]
  settings            BusinessSettings?
  cargoRecords        CargoRecord[]
  installmentPayments InstallmentPayment[]
  installments        Installment[]
  invitations         Invitation[]
  petrolPumpPurchases PetrolPumpPurchase[]
  petrolPumpRecords   PetrolPumpRecord[]
  auditLogs           WbosAuditLog[]
  personalExpenses   WbosPersonalExpense[]
  client              Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  roles               WbosRole[]
  users               WbosUser[]

  @@index([clientId])
  @@index([status])
  @@index([slug])
  @@map("wbos_businesses")
}

model WbosUser {
  id            String         @id @default(cuid())
  businessId    String
  email         String
  password      String?
  name          String
  avatar        String?
  status        String         @default("invited")
  personalExpenseEnabled Boolean @default(false)
  invitedAt     DateTime       @default(now())
  acceptedAt    DateTime?
  loginAttempts Int            @default(0)
  lockedUntil   DateTime?
  lastLogin     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  invitations   Invitation[]   @relation("InvitationRecipient")
  auditLogs     WbosAuditLog[] @relation("UserActions")
  roles         WbosUserRole[]
  personalExpenses WbosPersonalExpense[]
  business      WbosBusiness   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
  @@index([email])
  @@index([status])
  @@map("wbos_users")
}
model WbosPersonalExpense {
  id          String       @id @default(cuid())
  businessId  String
  userId      String
  amount      Decimal      @db.Decimal(12, 2)
  category    String
  description String
  notes       String?
  expenseDate DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  business    WbosBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        WbosUser     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([businessId, expenseDate])
  @@index([userId, expenseDate])
  @@map("wbos_personal_expenses")
}

model WbosRole {
  id          String               @id @default(cuid())
  businessId  String
  name        String
  description String?
  isSystem    Boolean              @default(false)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  invitations Invitation[]         @relation("InvitationRole")
  permissions WbosRolePermission[]
  business    WbosBusiness         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userRoles   WbosUserRole[]

  @@unique([businessId, name])
  @@map("wbos_roles")
}

model WbosUserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  role      WbosRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      WbosUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("wbos_user_roles")
}

model WbosPermission {
  id          String               @id @default(cuid())
  name        String               @unique
  description String?
  category    String
  resource    String
  action      String
  createdAt   DateTime             @default(now())
  roles       WbosRolePermission[]

  @@map("wbos_permissions")
}

model WbosRolePermission {
  id           String         @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime       @default(now())
  permission   WbosPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         WbosRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("wbos_role_permissions")
}

model Invitation {
  id            String       @id @default(cuid())
  businessId    String
  email         String
  name          String?
  roleId        String
  token         String       @unique
  expiresAt     DateTime
  status        String       @default("pending")
  acceptedAt    DateTime?
  acceptedBy    String?
  invitedBy     String
  invitedByType String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          WbosUser?    @relation("InvitationRecipient", fields: [acceptedBy], references: [id])
  business      WbosBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role          WbosRole     @relation("InvitationRole", fields: [roleId], references: [id])

  @@index([token])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
  @@map("invitations")
}

model BusinessModule {
  id            String       @id @default(cuid())
  businessId    String
  moduleKey     String
  enabled       Boolean      @default(true)
  configuration Json?
  enabledAt     DateTime?
  disabledAt    DateTime?
  createdBy     String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  business      WbosBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, moduleKey])
  @@map("business_modules")
}

model BusinessSettings {
  id                 String       @id @default(cuid())
  businessId         String       @unique
  brandColor         String?
  brandLogo          String?
  favicon            String?
  allowStaffInvites  Boolean      @default(true)
  allowSelfSignup    Boolean      @default(false)
  emailNotifications Boolean      @default(true)
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  business           WbosBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

model WbosAuditLog {
  id         String       @id @default(cuid())
  businessId String
  userId     String?
  adminId    String?
  action     String
  entityType String?
  entityId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())
  admin      Admin?       @relation(fields: [adminId], references: [id])
  business   WbosBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       WbosUser?    @relation("UserActions", fields: [userId], references: [id])

  @@index([businessId])
  @@index([userId])
  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("wbos_audit_logs")
}

model Bus {
  id            String             @id @default(cuid())
  busNumber     String             @unique
  numberPlate   String             @unique
  name          String?
  capacity      Int
  status        String             @default("active")
  purchaseDate  DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  businessId    String?
  fuelRecords   BusFuelRecord[]
  maintenance   BusMaintenance[]
  tyres         BusTyre[]
  vouchers      BusVoucher[]
  business      WbosBusiness?      @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dieselRecords PetrolPumpRecord[]

  @@index([busNumber])
  @@index([status])
  @@map("buses")
}

model BusVoucher {
  id                 String        @id @default(cuid())
  busId              String
  voucherDate        DateTime      @default(now())
  route              String
  tripNumber         String?
  individualPayments Decimal       @default(0)
  otherRevenue       Decimal       @default(0)
  totalRevenue       Decimal       @default(0)
  dieselExpense      Decimal       @default(0)
  taExpense          Decimal       @default(0)
  teaExpense         Decimal       @default(0)
  cleannessExpense   Decimal       @default(0)
  policeExpense      Decimal       @default(0)
  tollTaxExpense     Decimal       @default(0)
  numberMoneyExpense Decimal       @default(0)
  mechanicExpense    Decimal       @default(0)
  extraExpense       Decimal       @default(0)
  otherExpense       Decimal       @default(0)
  totalExpenses      Decimal       @default(0)
  profit             Decimal       @default(0)
  routeType          String        @default("lahore")
  status             String        @default("active")
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  pricePerSeat       Decimal       @default(0)
  seatsBooked        Int           @default(0)
  seatsRevenue       Decimal       @default(0)
  totalSeats         Int           @default(0)
  businessId         String?
  bus                Bus           @relation(fields: [busId], references: [id], onDelete: Cascade)
  business           WbosBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([busId])
  @@index([voucherDate])
  @@index([route])
  @@map("bus_vouchers")
}

model BusMaintenance {
  id              String        @id @default(cuid())
  busId           String
  maintenanceDate DateTime      @default(now())
  type            String
  description     String?
  cost            Decimal
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  businessId      String?
  bus             Bus           @relation(fields: [busId], references: [id], onDelete: Cascade)
  business        WbosBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([busId])
  @@index([maintenanceDate])
  @@map("bus_maintenance")
}

model BusTyre {
  id          String        @id @default(cuid())
  busId       String
  tyreDate    DateTime      @default(now())
  description String?
  cost        Decimal
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  businessId  String?
  bus         Bus           @relation(fields: [busId], references: [id], onDelete: Cascade)
  business    WbosBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([busId])
  @@index([tyreDate])
  @@map("bus_tyres")
}

model AddaIncome {
  id           String        @id @default(cuid())
  date         DateTime      @default(now())
  amount       Decimal
  description  String
  notes        String?
  isCommission Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  businessId   String?
  business     WbosBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date])
  @@map("adda_income")
}

model AddaExpense {
  id          String              @id @default(cuid())
  date        DateTime            @default(now())
  categoryId  String
  amount      Decimal
  description String?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  businessId  String?
  business    WbosBusiness?       @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category    AddaExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([date])
  @@index([categoryId])
  @@map("adda_expenses")
}

model AddaExpenseCategory {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  expenses    AddaExpense[]

  @@map("adda_expense_categories")
}

model PetrolPumpRecord {
  id            String        @id @default(cuid())
  busId         String?
  date          DateTime      @default(now())
  liters        Decimal
  pricePerLiter Decimal
  totalSales    Decimal       @default(0)
  fuelCost      Decimal       @default(0)
  notes         String?
  profit        Decimal       @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  businessId    String?
  bus           Bus?          @relation(fields: [busId], references: [id])
  business      WbosBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([busId])
  @@index([date])
  @@map("petrol_pump_records")
}

model BusFuelRecord {
  id            String        @id @default(cuid())
  busId         String
  date          DateTime      @default(now())
  liters        Decimal
  pricePerLiter Decimal
  totalAmount   Decimal
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  businessId    String?
  bus           Bus           @relation(fields: [busId], references: [id], onDelete: Cascade)
  business      WbosBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([busId])
  @@index([date])
  @@map("bus_fuel_records")
}

model PetrolPumpPurchase {
  id            String        @id @default(cuid())
  date          DateTime      @default(now())
  liters        Decimal
  pricePerLiter Decimal
  totalCost     Decimal
  supplier      String?
  invoiceNumber String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  businessId    String?
  business      WbosBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date])
  @@map("petrol_pump_purchases")
}

model CargoRecord {
  id          String        @id @default(cuid())
  date        DateTime      @default(now())
  description String
  profit      Decimal
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  businessId  String?
  business    WbosBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date])
  @@map("cargo_records")
}

model Installment {
  id               String               @id @default(cuid())
  name             String
  type             String               @default("bus")
  totalAmount      Decimal?
  paidAmount       Decimal              @default(0)
  monthlyDeduction Decimal              @default(0)
  remainingAmount  Decimal?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  assetCount       Int                  @default(1)
  dueDay           Int?
  lenderName       String?
  notes            String?
  referenceNumber  String?
  startDate        DateTime?
  businessId       String?
  payments         InstallmentPayment[]
  business         WbosBusiness?        @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("installments")
}

model InstallmentPayment {
  id              String        @id @default(cuid())
  installmentId   String
  paymentDate     DateTime      @default(now())
  amount          Decimal
  paymentMethod   String        @default("cash")
  referenceNumber String?
  notes           String?
  status          String        @default("active")
  recordedBy      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  businessId      String?
  business        WbosBusiness? @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  installment     Installment   @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@index([installmentId])
  @@index([paymentDate])
  @@map("installment_payments")
}

model MonthlySummary {
  id                   String   @id @default(cuid())
  month                String   @unique
  totalBusRevenue      Decimal  @default(0)
  totalBusExpenses     Decimal  @default(0)
  totalBusProfit       Decimal  @default(0)
  totalAddaIncome      Decimal  @default(0)
  totalAddaExpenses    Decimal  @default(0)
  totalAddaProfit      Decimal  @default(0)
  totalPetrolSales     Decimal  @default(0)
  totalPetrolCost      Decimal  @default(0)
  totalPetrolProfit    Decimal  @default(0)
  totalCargoProfit     Decimal  @default(0)
  totalMaintenanceCost Decimal  @default(0)
  totalTyreCost        Decimal  @default(0)
  totalInstallments    Decimal  @default(0)
  finalProfit          Decimal  @default(0)
  calculatedAt         DateTime @default(now())

  @@index([month])
  @@map("monthly_summaries")
}
